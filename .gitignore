# Ambiente virtual criado localmente
.venv/

# Arquivos temporários do Jupyter
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Arquivos temporários do Python
__pycache__/
*.pyc

# Arquivos gerados durante a execução
artifacts/

# Microdados baixados pelo pipeline
data/raw/

# Banco DuckDB gerado pelo pipeline
data/database/

# Arquivos DuckDB eventualmente criados em outras pastas
*.duckdb
*.duckdb.wal

# Variáveis de ambiente e informações sensíveis
.env